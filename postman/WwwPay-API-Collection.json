{
  "info": {
    "name": "WwwPay API Collection",
    "description": "API collection for WwwPay Laravel payment gateway package",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiToken",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"gateway\": \"stripe\",\n    \"amount\": 100.00,\n    \"currency\": \"USD\",\n    \"email\": \"customer@example.com\",\n    \"return_url\": \"{{baseUrl}}/payment/success\",\n    \"cancel_url\": \"{{baseUrl}}/payment/cancel\",\n    \"metadata\": {\n        \"order_id\": \"ORD-12345\"\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment"]
            },
            "description": "Create a new payment"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payment/verify?transaction_id=txn_123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "verify"],
              "query": [
                {
                  "key": "transaction_id",
                  "value": "txn_123"
                }
              ]
            },
            "description": "Verify a payment transaction"
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"transaction_id\": \"txn_123\",\n    \"amount\": 50.00,\n    \"reason\": \"Customer requested refund\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "refund"]
            },
            "description": "Refund a payment"
          }
        }
      ]
    },
    {
      "name": "Subscriptions",
      "item": [
        {
          "name": "Create Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"gateway\": \"stripe\",\n    \"plan_id\": \"price_monthly\",\n    \"customer_email\": \"customer@example.com\",\n    \"payment_method\": \"pm_card_visa\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/subscription",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subscription"]
            },
            "description": "Create a new subscription"
          }
        },
        {
          "name": "Cancel Subscription",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/subscription/sub_123",
              "host": ["{{baseUrl}}"],
              "path": ["api", "subscription", "sub_123"]
            },
            "description": "Cancel an existing subscription"
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Stripe Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Stripe-Signature",
                "value": "whsec_xxx"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"type\": \"payment_intent.succeeded\",\n    \"data\": {\n        \"object\": {\n            \"id\": \"pi_123\",\n            \"amount\": 10000,\n            \"currency\": \"usd\"\n        }\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhook/stripe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhook", "stripe"]
            },
            "description": "Handle Stripe webhook events"
          }
        },
        {
          "name": "PayPal Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n    \"resource\": {\n        \"id\": \"8MC585209K746631G\",\n        \"amount\": {\n            \"value\": \"100.00\",\n            \"currency_code\": \"USD\"\n        }\n    }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/webhook/paypal",
              "host": ["{{baseUrl}}"],
              "path": ["api", "webhook", "paypal"]
            },
            "description": "Handle PayPal webhook events"
          }
        }
      ]
    },
    {
      "name": "B2B Payments",
      "item": [
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 1000.00,\n    \"currency\": \"USD\",\n    \"client_name\": \"Acme Corp\",\n    \"client_email\": \"billing@acme.com\",\n    \"due_date\": \"2025-12-31\",\n    \"items\": [\n        {\n            \"description\": \"Web Development\",\n            \"quantity\": 1,\n            \"price\": 1000.00\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/b2b/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["api", "b2b", "invoice"]
            },
            "description": "Create a B2B invoice"
          }
        },
        {
          "name": "Create Wire Transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 5000.00,\n    \"currency\": \"EUR\",\n    \"iban\": \"DE89370400440532013000\",\n    \"bic\": \"COBADEFFXXX\",\n    \"beneficiary_name\": \"Acme GmbH\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/b2b/wire-transfer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "b2b", "wire-transfer"]
            },
            "description": "Create a wire transfer"
          }
        }
      ]
    },
    {
      "name": "P2P Payments",
      "item": [
        {
          "name": "Send Money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"amount\": 100.00,\n    \"currency\": \"USD\",\n    \"recipient_id\": \"user_456\",\n    \"note\": \"For dinner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/p2p/send",
              "host": ["{{baseUrl}}"],
              "path": ["api", "p2p", "send"]
            },
            "description": "Send money to another user"
          }
        },
        {
          "name": "Split Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"total_amount\": 300.00,\n    \"currency\": \"USD\",\n    \"participants\": [\"user_1\", \"user_2\", \"user_3\"],\n    \"split_equally\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/p2p/split",
              "host": ["{{baseUrl}}"],
              "path": ["api", "p2p", "split"]
            },
            "description": "Split a payment between users"
          }
        }
      ]
    },
    {
      "name": "Gateways",
      "item": [
        {
          "name": "List Available Gateways",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gateways",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gateways"]
            },
            "description": "Get list of available payment gateways"
          }
        },
        {
          "name": "List Gateways by Region",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gateways?region=south_asia",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gateways"],
              "query": [
                {
                  "key": "region",
                  "value": "south_asia"
                }
              ]
            },
            "description": "Get gateways filtered by region"
          }
        },
        {
          "name": "Test Gateway Connection",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gateways/stripe/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gateways", "stripe", "test"]
            },
            "description": "Test a specific gateway connection"
          }
        }
      ]
    }
  ]
}
