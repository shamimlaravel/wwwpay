{
    "name": "shamimstack/wwwpay",
    "description": "All-in-one payment gateway package for Laravel - 33+ global, crypto, and regional payment methods",
    "keywords": [
        "laravel",
        "payment",
        "gateway",
        "stripe",
        "paypal",
        "bkash",
        "nagad",
        "upi",
        "phonepe",
        "paytm",
        "jazzcash",
        "easypaisa",
        "paytabs",
        "telr",
        "mada",
        "payfast",
        "snapscan",
        "alipay",
        "wechat",
        "bitcoin",
        "ethereum",
        "crypto",
        "square",
        "authorize",
        "moneris",
        "mercadopago",
        "pagseguro",
        "klarna",
        "adyen",
        "ideal",
        "bancontact",
        "flutterwave",
        "paystack",
        "mpesa",
        "fawry",
        "paypay",
        "linepay",
        "grabpay",
        "wwwpay"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "shamimstack",
            "email": "shamimstack@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0",
        "stripe/stripe-php": "^12.0",
        "paypal/rest-api-sdk-php": "^1.14",
        "firebase/php-jwt": "^6.0",
        "ext-json": "*",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "ShamimStack\\WwwPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ShamimStack\\WwwPay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ShamimStack\\WwwPay\\Providers\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "ShamimStack\\WwwPay\\Facades\\Payment"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
