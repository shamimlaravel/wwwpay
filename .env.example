APP_NAME=WwwPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wwwpay
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Payment Gateways
PAYMENT_DEFAULT_GATEWAY=stripe

# Stripe
STRIPE_KEY=sk_test_xxxxx
STRIPE_SECRET=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# PayPal
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_MODE=sandbox

# Paystack (Africa)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# bKash (Bangladesh)
BKASH_APP_KEY=xxxxx
BKASH_APP_SECRET=xxxxx
BKASH_USERNAME=xxxxx
BKASH_PASSWORD=xxxxx
BKASH_MODE=sandbox

# Flutterwave (Africa)
FLUTTERWAVE_PUBLIC_KEY=pk_test_xxxxx
FLUTTERWAVE_SECRET_KEY=sk_test_xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=xxxxx

# Mada (Saudi Arabia)
MADA_API_KEY=xxxxx
MADA_ENTITY_ID=xxxxx
